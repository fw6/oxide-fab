# PostgreSQL with pgBackRest, so the same cluster can archive WAL and take
# full backups into the S3-compatible `oxide-backup` bucket.
FROM postgres:18-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends pgbackrest ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# pgBackRest reads PGBACKREST_* environment variables (see docker-compose.yml),
# so no credential is baked into the image.
