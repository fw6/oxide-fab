COMPOSE_PROJECT_NAME=oxide-fab

# Demo credentials only. Never use these values for anything real.
POSTGRES_DB=oxide
POSTGRES_USER=oxide
POSTGRES_PASSWORD=oxide_demo_pw

MINIO_ROOT_USER=oxide
MINIO_ROOT_PASSWORD=oxide_demo_pw
MINIO_DATA_BUCKET=oxide-data
MINIO_BACKUP_BUCKET=oxide-backup

# Application
OXIDE_HTTP_ADDR=0.0.0.0:8080
