COMPOSE_PROJECT_NAME=oxide-fab

# Demo credentials only. Never use these values for anything real.
POSTGRES_DB=oxide
POSTGRES_USER=oxide
POSTGRES_PASSWORD=oxide_demo_pw

# S3-compatible object store: MinIO, built from its pinned source
# (Dockerfile.minio, ADR 004). The bucket names stay oxide-data and
# oxide-backup.
S3_ACCESS_KEY_ID=oxide
S3_SECRET_ACCESS_KEY=oxide_demo_pw
S3_DATA_BUCKET=oxide-data
S3_BACKUP_BUCKET=oxide-backup

# Application
OXIDE_HTTP_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://oxide:oxide_demo_pw@postgres:5432/oxide
GREPTIME_URL=http://greptimedb:4000
GREPTIME_DB=public
SCENARIO_PATH=config/scenario.json
RUST_LOG=info,oxide=debug
