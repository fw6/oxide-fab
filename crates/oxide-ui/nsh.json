{
  "name": "氧化层 oxide-fab",
  "id": "com.fw6.oxidefab",
  "version": "0.2.0",
  "build": 1,
  "nsh": ">=0.6",
  "rust": ".",
  "theme": "theme.json",
  "appearance": "dark",
  "icon": "icon.png",
  "capabilities": {
    "application": true,
    "network": {
      "hosts": ["*"]
    },
    "statusBar": true,
    "process": {
      "env": [
        "OXIDE_DEMO",
        "OXIDE_API_URL",
        "OXIDE_THEME",
        "OXIDE_EXPLODE",
        "OXIDE_TAB",
        "OXIDE_WHATIF",
        "OXIDE_VIEW",
        "OXIDE_REPO_ROOT",
        "OXIDE_RENDER_DISABLE",
        "OXIDE_RENDER_SOFTWARE"
      ]
    }
  },
  "window": {
    "title": "氧化层 oxide-fab · 3D 工作台",
    "defaultSize": {
      "width": 1500,
      "height": 940
    },
    "minSize": {
      "width": 1120,
      "height": 720
    }
  },
  "macos": {
    "infoPlist": {
      "LSMinimumSystemVersion": "14.0"
    }
  }
}
